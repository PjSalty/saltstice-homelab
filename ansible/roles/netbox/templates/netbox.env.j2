## NetBox environment — managed by Ansible
DB_HOST=postgres
DB_NAME={{ netbox_db_name }}
DB_USER={{ netbox_db_user }}
DB_PASSWORD={{ creds.infrastructure.netbox.db_password | default('PLACEHOLDER') }}
REDIS_HOST=redis
REDIS_PORT=6379
SECRET_KEY={{ creds.infrastructure.netbox.secret_key | default('PLACEHOLDER') }}
SUPERUSER_NAME={{ netbox_superuser_name }}
SUPERUSER_EMAIL={{ netbox_superuser_email }}
SUPERUSER_PASSWORD={{ creds.infrastructure.netbox.admin_password | default('PLACEHOLDER') }}
SUPERUSER_API_TOKEN={{ creds.infrastructure.netbox.api_token | default('PLACEHOLDER') }}
ALLOWED_HOSTS=*
LOGIN_REQUIRED={{ netbox_login_required | lower }}
METRICS_ENABLED={{ netbox_metrics_enabled | lower }}
