# {{ ansible_managed }}
services:
  wg-easy:
    image: ghcr.io/wg-easy/wg-easy:{{ vpn_wgeasy_version }}
    restart: unless-stopped
    hostname: {{ vpn_fqdn }}
    ports:
      - "{{ vpn_wg_port }}:51820/udp"
      - "{{ vpn_ui_port }}:51821/tcp"
    volumes:
      - {{ vpn_data_dir }}:/etc/wireguard
    environment:
      LANG: en
      WG_HOST: "{{ vpn_fqdn }}"
      PASSWORD_HASH: "{{ vpn_password_hash }}"
      WG_DEFAULT_ADDRESS: "{{ vpn_address_range }}"
      WG_DEFAULT_DNS: "{{ vpn_dns }}"
      WG_ALLOWED_IPS: "{{ vpn_allowed_ips }}"
      WG_PERSISTENT_KEEPALIVE: "25"
    cap_add:
      - NET_ADMIN
      - SYS_MODULE
    sysctls:
      - net.ipv4.ip_forward=1
      - net.ipv4.conf.all.src_valid_mark=1
