# {{ ansible_managed }}
hostname: {{ harbor_fqdn }}

https:
  port: 443
  certificate: {{ harbor_cert_dir }}/server.crt
  private_key: {{ harbor_cert_dir }}/server.key

http:
  port: 80

harbor_admin_password: {{ harbor_admin_password }}

# Re-enable basic auth alongside OIDC (required for API automation)
# Without this, all authenticated API calls return 401 when auth_mode=oidc_auth
primary_auth_mode: true

database:
  password: {{ harbor_db_password }}
  max_idle_conns: 100
  max_open_conns: 900
  conn_max_lifetime: 5m
  conn_max_idle_time: 0

data_volume: {{ harbor_data_storage }}

trivy:
  ignore_unfixed: false
  skip_update: false
  skip_java_db_update: false
  insecure: false

jobservice:
  max_job_workers: 10
  job_loggers:
    - STD_OUTPUT
    - FILE
  logger_sweeper_duration: 1

notification:
  webhook_job_max_retry: 3
  webhook_job_http_client_timeout: 3

log:
  level: info
  local:
    rotate_count: 50
    rotate_size: 200M
    location: {{ harbor_log_dir }}

proxy:
  http_proxy:
  https_proxy:
  no_proxy:
  components:
    - core
    - jobservice
    - trivy

upload_purging:
  enabled: true
  age: 168h
  interval: 24h
  dryrun: false

cache:
  enabled: false
  expire_hours: 24
