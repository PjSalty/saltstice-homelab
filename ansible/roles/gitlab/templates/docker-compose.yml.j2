# {{ ansible_managed }}
services:
  gitlab:
    image: gitlab/gitlab-ce:{{ gitlab_version }}
    container_name: gitlab
    restart: unless-stopped
    hostname: {{ gitlab_fqdn }}
    ports:
      - "80:80"
      - "443:443"
      - "{{ gitlab_ssh_port }}:22"
    volumes:
      - {{ gitlab_config_dir }}:/etc/gitlab
      - {{ gitlab_logs_dir }}:/var/log/gitlab
      - {{ gitlab_data_storage }}:/var/opt/gitlab
    shm_size: "256m"
    environment:
      GITLAB_OMNIBUS_CONFIG: |
        external_url 'https://{{ gitlab_fqdn }}'
        nginx['redirect_http_to_https'] = true
        nginx['ssl_certificate'] = '/etc/gitlab/ssl/{{ gitlab_fqdn }}.crt'
        nginx['ssl_certificate_key'] = '/etc/gitlab/ssl/{{ gitlab_fqdn }}.key'
        gitlab_rails['gitlab_shell_ssh_port'] = {{ gitlab_ssh_port }}
        gitlab_rails['time_zone'] = '{{ timezone }}'
