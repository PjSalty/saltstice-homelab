# {{ ansible_managed }}

global_defs {
    router_id {{ ansible_hostname }}
    enable_script_security
    script_user root
}

vrrp_script check_haproxy {
    script "/usr/bin/killall -0 haproxy"
    interval 2
    weight 2
    fall 2
    rise 2
}

vrrp_instance VI_1 {
    state {{ 'MASTER' if haproxy_role == 'master' else 'BACKUP' }}
    interface eth0
    virtual_router_id 51
    priority {{ keepalived_priority }}
    advert_int 1

    authentication {
        auth_type PASS
        auth_pass {{ haproxy_keepalived_auth_pass }}
    }

    virtual_ipaddress {
        {{ haproxy_vip }}/24
    }

    track_script {
        check_haproxy
    }

{% if haproxy_role == 'master' %}
    notify_master "/usr/bin/systemctl start haproxy"
    notify_backup "/usr/bin/systemctl stop haproxy"
    notify_fault "/usr/bin/systemctl stop haproxy"
{% else %}
    notify_master "/usr/bin/systemctl start haproxy"
    notify_backup "/usr/bin/systemctl status haproxy || /usr/bin/systemctl start haproxy"
    notify_fault "/usr/bin/systemctl stop haproxy"
{% endif %}
}
